@page "/batches/{BatchID:int}"
@attribute [Authorize(Policy = "RequireRequester")]
@inject IBatchService BatchSvc
@inject IMasterDataService MasterSvc
@inject IDialogService Dialog
@inject ISnackbar Snackbar
@inject AppStateService AppState
@using SmartPricing.Application.DTOs
@using SmartPricing.Application.Interfaces
@using SmartPricing.Domain.Enums
@using SmartPricing.Web.Services
@using MudBlazor

<PageTitle>Batch Detail — Smart Pricing</PageTitle>

@if (_batch is null && !_loading)
{
    <MudText Class="pa-8 text-muted">Batch δεν βρέθηκε / Batch not found.</MudText>
}
else if (_batch is not null)
{
    <div class="sp-page-header">
        <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <div>
                <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.h4" Class="fw-700">@_batch.BatchName</MudText>
                    <StatusBadge Status="@_batch.Status" />
                </MudStack>
                <div class="text-muted">
                    Δημιουργήθηκε: @_batch.CreatedAt.ToString("dd/MM/yyyy HH:mm") από @_batch.CreatedByName
                </div>
            </div>
            <MudStack Row Spacing="2">
                @if (_batch.Status == BatchStatus.Draft)
                {
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add"
                               OnClick="OpenAddLineDialog">
                        Προσθήκη Γραμμής / Add Line
                    </MudButton>
                    @if (_batch.Lines.Any())
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Send" OnClick="SubmitBatch">
                            Υποβολή / Submit
                        </MudButton>
                    }
                }
                @if (_batch.Status == BatchStatus.Submitted && AppState.IsApprover)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Success"
                               StartIcon="@Icons.Material.Filled.CheckCircle" OnClick="ApproveBatch"
                               Disabled="!_batch.Lines.All(l => l.LineStatus == LineStatus.Approved)">
                        Έγκριση Batch / Approve All
                    </MudButton>
                }
            </MudStack>
        </MudStack>
    </div>

    <!-- Batch Meta -->
    <MudGrid Spacing="3" Class="mb-4">
        <MudItem xs="12" md="8">
            <div class="sp-card">
                <div class="sp-card-header"><h6>📋 Γραμμές Ανατίμησης / Price Change Lines</h6></div>
                <MudTable Items="_batch.Lines" Hover Dense Elevation="0" MultiSelection
                          @bind-SelectedItems="_selectedLines">
                    <HeaderContent>
                        <MudTh>Είδος / Item</MudTh>
                        <MudTh>Κανάλι</MudTh>
                        <MudTh Style="text-align:right">Παλιά Τιμή</MudTh>
                        <MudTh Style="text-align:right">Νέα Τιμή</MudTh>
                        <MudTh Style="text-align:right">Μεταβολή%</MudTh>
                        <MudTh Style="text-align:right">GM%</MudTh>
                        <MudTh>Status</MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>
                            <div style="font-weight:600">@context.ItemName</div>
                            <div class="text-muted text-mono" style="font-size:.72rem">@context.ERPItemCode</div>
                        </MudTd>
                        <MudTd><MudChip T="string" Size="Size.Small">@context.ChannelName</MudChip></MudTd>
                        <MudTd Style="text-align:right" Class="price-value text-muted">
                            @(context.OldPrice?.ToString("N2") ?? "—")
                        </MudTd>
                        <MudTd Style="text-align:right">
                            <strong class="price-value" style="color:#1A56DB">@context.NewPrice.ToString("N2")</strong>
                        </MudTd>
                        <MudTd Style="text-align:right">
                            @if (context.OldPrice.HasValue && context.OldPrice > 0)
                            {
                                var pct = (context.NewPrice - context.OldPrice.Value) / context.OldPrice.Value * 100;
                                <span class="@(pct >= 0 ? "price-change-up" : "price-change-down") text-mono">
                                    @(pct >= 0 ? "+" : "")@pct.ToString("F1")%
                                </span>
                            }
                            else { <span class="text-muted">—</span> }
                        </MudTd>
                        <MudTd Style="text-align:right" Class="price-value">
                            @(context.MarginPercent.HasValue ? $"{context.MarginPercent:F2}%" : "—")
                        </MudTd>
                        <MudTd>
                            <LineStatusBadge Status="@context.LineStatus" />
                        </MudTd>
                        <MudTd>
                            @if (_batch.Status == BatchStatus.Draft)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                               Color="Color.Error" OnClick="@(() => RemoveLine(context.LineID))" />
                            }
                            @if (_batch.Status == BatchStatus.Submitted && AppState.IsApprover && context.LineStatus == LineStatus.Pending)
                            {
                                <MudStack Row Spacing="1">
                                    <MudIconButton Icon="@Icons.Material.Filled.Check" Color="Color.Success"
                                                   Size="Size.Small" OnClick="@(() => ApproveLine(context.LineID))" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Error"
                                                   Size="Size.Small" OnClick="@(() => RejectLine(context.LineID))" />
                                </MudStack>
                            }
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText Class="pa-4 text-muted" Style="text-align:center">
                            Δεν υπάρχουν γραμμές. Προσθέστε γραμμές ανατίμησης.
                        </MudText>
                    </NoRecordsContent>
                </MudTable>

                @if (_batch.Status == BatchStatus.Submitted && AppState.IsApprover && _selectedLines.Any())
                {
                    <div style="padding:12px 16px;border-top:1px solid var(--sp-border);background:#FAFBFD">
                        <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.body2">@_selectedLines.Count επιλεγμένες / selected:</MudText>
                            <MudButton Size="Size.Small" Color="Color.Success" Variant="Variant.Filled"
                                       OnClick="ApproveSelected">✅ Έγκριση Επιλεγμένων</MudButton>
                            <MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Filled"
                                       OnClick="RejectSelected">❌ Απόρριψη Επιλεγμένων</MudButton>
                        </MudStack>
                    </div>
                }
            </div>
        </MudItem>

        <!-- Batch Info Panel -->
        <MudItem xs="12" md="4">
            <div class="sp-card">
                <div class="sp-card-header"><h6>ℹ️ Στοιχεία Batch</h6></div>
                <MudList T="string" Dense>
                    <MudListItem Icon="@Icons.Material.Filled.Person">
                        <MudText Typo="Typo.caption" Class="text-muted">Δημιουργός</MudText>
                        <div>@_batch.CreatedByName</div>
                    </MudListItem>
                    @if (_batch.SubmittedByName is not null)
                    {
                        <MudListItem Icon="@Icons.Material.Filled.Send">
                            <MudText Typo="Typo.caption" Class="text-muted">Υποβλήθηκε από</MudText>
                            <div>@_batch.SubmittedByName — @_batch.SubmittedAt?.ToString("dd/MM/yyyy HH:mm")</div>
                        </MudListItem>
                    }
                    @if (_batch.ApprovedByName is not null)
                    {
                        <MudListItem Icon="@Icons.Material.Filled.CheckCircle">
                            <MudText Typo="Typo.caption" Class="text-muted">Εγκρίθηκε από</MudText>
                            <div>@_batch.ApprovedByName — @_batch.ApprovedAt?.ToString("dd/MM/yyyy HH:mm")</div>
                        </MudListItem>
                    }
                    <MudDivider />
                    <MudListItem>
                        <MudStack Row Justify="Justify.SpaceBetween">
                            <div>📊 Σύνολο γραμμών:</div>
                            <strong>@_batch.Lines.Count</strong>
                        </MudStack>
                    </MudListItem>
                    <MudListItem>
                        <MudStack Row Justify="Justify.SpaceBetween">
                            <div>✅ Εγκεκριμένες:</div>
                            <strong style="color:var(--sp-green)">@_batch.Lines.Count(l => l.LineStatus == LineStatus.Approved)</strong>
                        </MudStack>
                    </MudListItem>
                    <MudListItem>
                        <MudStack Row Justify="Justify.SpaceBetween">
                            <div>❌ Απορριφθείσες:</div>
                            <strong style="color:var(--sp-red)">@_batch.Lines.Count(l => l.LineStatus == LineStatus.Rejected)</strong>
                        </MudStack>
                    </MudListItem>
                </MudList>
            </div>
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter] public int BatchID { get; set; }

    private BatchDetailDto? _batch;
    private bool _loading = true;
    private HashSet<BatchLineDto> _selectedLines = [];

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        _loading = true;
        _batch = await BatchSvc.GetByIdAsync(BatchID);
        _loading = false;
    }

    private async Task OpenAddLineDialog()
    {
        var parameters = new DialogParameters { ["BatchID"] = BatchID };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await Dialog.ShowAsync<AddBatchLineDialog>("Προσθήκη Γραμμής", parameters, options);
        var result = await dialog.Result;
        if (!result!.Canceled) await LoadData();
    }

    private async Task RemoveLine(int lineID)
    {
        var ok = await Dialog.ShowMessageBox("Διαγραφή", "Διαγραφή γραμμής;", "Ναι", "Όχι");
        if (ok == true) { await BatchSvc.RemoveLineAsync(lineID); await LoadData(); }
    }

    private async Task SubmitBatch()
    {
        var ok = await Dialog.ShowMessageBox("Υποβολή", "Υποβολή batch για έγκριση;", "Ναι", "Όχι");
        if (ok == true)
        {
            await BatchSvc.SubmitAsync(BatchID, AppState.CurrentUserID);
            Snackbar.Add("Υποβλήθηκε επιτυχώς.", Severity.Success);
            await LoadData();
        }
    }

    private async Task ApproveLine(int lineID)
    {
        await BatchSvc.ApproveLinesAsync([new ApproveBatchLineDto(lineID, AppState.CurrentUserID, null)]);
        Snackbar.Add("Εγκρίθηκε.", Severity.Success);
        await LoadData();
    }

    private async Task RejectLine(int lineID)
    {
        await BatchSvc.RejectLinesAsync([new RejectBatchLineDto(lineID, AppState.CurrentUserID, null)]);
        Snackbar.Add("Απορρίφθηκε.", Severity.Warning);
        await LoadData();
    }

    private async Task ApproveSelected()
    {
        var dtos = _selectedLines.Select(l => new ApproveBatchLineDto(l.LineID, AppState.CurrentUserID, null)).ToList();
        await BatchSvc.ApproveLinesAsync(dtos);
        Snackbar.Add($"Εγκρίθηκαν {dtos.Count} γραμμές.", Severity.Success);
        _selectedLines.Clear();
        await LoadData();
    }

    private async Task RejectSelected()
    {
        var dtos = _selectedLines.Select(l => new RejectBatchLineDto(l.LineID, AppState.CurrentUserID, null)).ToList();
        await BatchSvc.RejectLinesAsync(dtos);
        Snackbar.Add($"Απορρίφθηκαν {dtos.Count} γραμμές.", Severity.Warning);
        _selectedLines.Clear();
        await LoadData();
    }

    private async Task ApproveBatch()
    {
        var ok = await Dialog.ShowMessageBox("Έγκριση Batch", "Οριστική έγκριση και αποστολή τιμών στο ERP;", "Ναι", "Όχι");
        if (ok == true)
        {
            try
            {
                await BatchSvc.ApproveBatchAsync(BatchID, AppState.CurrentUserID);
                Snackbar.Add("Το batch εγκρίθηκε! Οι τιμές ενημερώθηκαν.", Severity.Success);
                await LoadData();
            }
            catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        }
    }
}
