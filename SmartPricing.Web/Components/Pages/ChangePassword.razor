@page "/account/change-password"
@layout EmptyLayout
@attribute [Authorize]
@attribute [ExcludeFromInteractiveRouting]
@using MudBlazor

<PageTitle>Change Password — Smart Pricing Control</PageTitle>

<div class="sp-login-page">
    <div class="sp-login-card">
        <div class="sp-login-logo">
            Smart<span>Pricing</span>
        </div>
        <div class="text-muted mb-6">Αλλαγή Κωδικού / Change Password</div>

        <form method="post" action="/account/change-password">
            <AntiforgeryToken />

            <MudStack Spacing="3">
                <MudTextField T="string" UserAttributes="@(new() { ["name"] = "currentPassword", ["autocomplete"] = "current-password" })"
                              Label="Τρέχων κωδικός / Current password"
                              Variant="Variant.Outlined" InputType="InputType.Password" />

                <MudTextField T="string" UserAttributes="@(new() { ["name"] = "newPassword", ["autocomplete"] = "new-password" })"
                              Label="Νέος κωδικός / New password"
                              HelperText="@($"Min {SmartPricing.Web.Services.PasswordPolicy.MinLength} chars, upper & lower case, digit")"
                              Variant="Variant.Outlined" InputType="InputType.Password" />

                <MudTextField T="string" UserAttributes="@(new() { ["name"] = "confirmPassword", ["autocomplete"] = "new-password" })"
                              Label="Επιβεβαίωση / Confirm"
                              Variant="Variant.Outlined" InputType="InputType.Password" />

                @if (Error is not null)
                {
                    <MudAlert Severity="Severity.Error" Dense>@Error</MudAlert>
                }

                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled"
                           Color="Color.Primary" FullWidth Size="Size.Large"
                           Style="font-weight:700;letter-spacing:.5px">
                    Αποθήκευση / Save
                </MudButton>
                <MudLink Href="/logout" Class="text-muted" Style="text-align:center;font-size:.8rem">
                    Αποσύνδεση / Logout
                </MudLink>
            </MudStack>
        </form>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? Error { get; set; }
}
